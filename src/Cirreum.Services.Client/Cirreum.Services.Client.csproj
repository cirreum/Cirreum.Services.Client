<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<RootNamespace>Cirreum</RootNamespace>
		<Description>The Services Infrastructure Library for WebAssembly Client applications.</Description>
		<PackageTags>cirreum;infrastructure;services;webassembly</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="10.0.0" />
		<PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.9.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Cirreum.Core" Version="1.0.15" />
		<PackageReference Include="Cirreum.Startup" Version="1.0.103" />
		<PackageReference Include="Cirreum.Storage.Browser" Version="1.0.103" />
	</ItemGroup>

	<!-- No JS/TS Maps or Comments -->
	<PropertyGroup>
		<TypeScriptRemoveComments>true</TypeScriptRemoveComments>
		<TypeScriptSourceMap>false</TypeScriptSourceMap>
	</PropertyGroup>

	<!-- Exclulde JSON Compiler Config files -->
	<ItemGroup>
		<Content Update="tsconfig.json" CopyToOutputDirectory="Never" Pack="false" />
	</ItemGroup>

</Project>